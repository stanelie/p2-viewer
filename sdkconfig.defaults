CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_LOG_COLORS=y

# Boot time. The PSRAM power-on memory test costs ~890ms of the ~3s to first image and is a
# manufacturing diagnostic, not something this build needs on every start.
CONFIG_SPIRAM_MEMTEST=n

# ---- boot time, round 2 ----
# The boot log is ~1.5KB and ESP_LOG to UART blocks, which is ~130ms at 115200. Raising the
# console baud keeps full diagnostics while cutting that ~8x. Serial tools must match.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# Bootloader prints ~20 lines we never read in normal use.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# Skip the SHA256 of the ~390KB app image on a power-on boot.
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
# -O2. This is a per-frame-budget-bound app, so favour speed over size.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Allows raising a component's log level to DEBUG at runtime (used by P2_DIAG). Costs flash only.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
# Tried CONFIG_ESPTOOLPY_FLASHMODE_QIO: the esp32p4 target forces CONFIG_ESPTOOLPY_FLASHMODE="dio"
# regardless, so it had no effect. Left out rather than left in looking effective.
# Nothing reads the bootloader banner in normal use, and UART output blocks.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# Custom partition table: adds a 64KB 'ffc' partition for the persisted flat-field offset table
# (48KB, which does not fit the 24KB NVS partition).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"


# The board carries 16MB of flash but the image header declared 2MB, so the bootloader logged
# "Detected size(16384k) larger than the size in the binary image header(2048k)" and ignored the
# rest. Declaring the true size makes the whole chip addressable.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Some UVC cameras do not set the End-of-Header bit in the payload header, and the component
# rejects every such payload ("uvc-frame: EOH bit not set"), so no frame ever completes. Measured
# against an iMac webcam: the stream opened, data arrived, and every payload was discarded. The P2
# Pro sets it correctly and is unaffected either way. This is a Kconfig option rather than a patch
# to managed_components, so it survives a component upgrade.
CONFIG_UVC_CHECK_PAYLOAD_HEADER_EOH=n
# The borescope's payloads are rejected with the ERR-bit check enabled (stream opens, no frame
# ever completes). Same class of quirk as the EOH bit above.
CONFIG_UVC_CHECK_PAYLOAD_HEADER_ERR=n

# ---- Built-in OV5647 on the board's MIPI-CSI connector -------------------------------------
# Shown when no USB camera is attached. The CSI video device pulls in the ISP, which is what
# demosaics the sensor's Bayer output and lets us ask for RGB565 straight out - the same pixel
# format the generic USB path already feeds to PPA.
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_CAMERA_OV5647=y
# RAW8 800x1280 rather than Waveshare's RAW10 1280x960. The sensor is mounted 90 degrees off the
# panel, so the picture is rotated before display and the sensor's PORTRAIT mode is the one that
# matches a landscape panel: rotated it is 1280x800, which fits 480x320 at a 6/16 scale in both
# axes - exactly on PPA's 1/16 grid - giving 480x300, i.e. the full panel width. The 800x640 mode
# tried first rotated to 640x800 and could only fill 240x300, half the width.
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280x960_BINNING_45FPS=y

# ---- PSRAM throughput for the CSI/ISP capture path ------------------------------------------
# Waveshare's own camera examples run a 256 KB L2 with 128-byte lines; we were on 128 KB / 64 B.
# The capture path is a streaming PSRAM writer and PPA's rotating read is strided, so both are
# cache-line sensitive. NOTE: PPA validates out.buffer_size against the cache line, so
# P2_CACHE_LINE in p2pro_uvc.c derives from CONFIG_CACHE_L2_CACHE_LINE_SIZE - do not hardcode 64.
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# Present from esp_video 0.9.0 on; Waveshare's own camera demo enables it.
CONFIG_ESP_VIDEO_ENABLE_DATA_PREPROCESSING=y
